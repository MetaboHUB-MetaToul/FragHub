        <mxCell id="vYlSyrvaL-nILZxWqhl--3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=12;fontColor=default;fontStyle=1;container=0;" value="&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;• Point d&#39;entrée de l&#39;interface utilisateur configuré avec un thème visuel clair&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;• Chargement et affichage dynamique des différentes vues/pages de l&#39;application&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;• Blocage de la sélection de texte et du défilement global de la page pour imiter le comportement d&#39;un logiciel de bureau classique&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="169.5" width="479.93" x="70.02999999999997" y="874.75" as="geometry" />
