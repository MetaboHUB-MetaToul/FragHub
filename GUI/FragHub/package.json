{
  "name": "FragHub",
  "version": "1.4.2",
  "main": "electron/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron": "electron electron/main.js",
    "build:electron": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "darkreader": "^4.9.125",
    "electron": "^42.3.0",
    "electron-builder": "^25.1.8",
    "nuxt": "^4.4.6",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vuetify": "^4.0.8",
    "vuetify-nuxt-module": "^0.19.5"
  },
  "build": {
    "appId": "com.fraghub.app",
    "productName": "FragHub",
    "npmRebuild": false,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      ".output/public/**/*",
      "electron/**/*",
      "package.json",
      "app/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../../scripts/dist/FragHub_Backend/",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "app/assets/FragHub_icon.png"
    }
  }
}